[Unit]
Description=SnapLink presentation image uploads
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/02_hackathon/slides
Environment=SLIDES_DATA=/var/lib/snaplink-slides
ExecStart=/home/ubuntu/workspace/02_hackathon/.venv/bin/python /home/ubuntu/workspace/02_hackathon/slides/slides_asset_server.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
